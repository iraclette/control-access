#pragma once

// Copy this file to secrets.h (gitignored) and fill in real values.
// secrets.h must match the DEVICE_SECRET and PIN_SALT the backend is configured with
// (backend/.env), or devices won't authenticate / PIN hashes won't match.

#define SECRET_WIFI_SSID     "your-wifi-ssid"
#define SECRET_WIFI_PASSWORD "your-wifi-password"
#define SECRET_DEVICE_SECRET "shared-device-secret-matching-backend-.env"
#define SECRET_PIN_SALT      "pin-salt-matching-backend-.env"
