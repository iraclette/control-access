# Copy to .env.local. For local development, `supabase status -o env` prints these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used by /api/leads to write leads (browsers have no access to that table).
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 = show the "demo data" banner and keep the site out of search engines.
NEXT_PUBLIC_DEMO=1

# Server only: the access backend (FastAPI) that serves the developer console API.
ACCESS_API_URL=http://127.0.0.1:8000
